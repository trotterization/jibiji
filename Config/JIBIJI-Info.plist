<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from INFOPLIST_KEY_* build settings. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<!-- One window for now: the prototype has a single page, and two windows
		     editing the same page would overwrite each other's saves. -->
